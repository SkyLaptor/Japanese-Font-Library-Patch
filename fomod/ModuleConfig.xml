<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Japanese Font Library Patch</moduleName>
  <moduleImage path="assets/images/eyecatch/eyecatch.jpg" />

  <installSteps order="Explicit">

    <!-- バグ修正 -->
    <installStep name="バグ修正">
      <optionalFileGroups order="Explicit">
        <group name="Racemenuでキャラ名に日本語が使用できない問題" type="SelectAtMostOne">
          <plugins>

            <plugin name="しねきゃぷしょん 幅50%">
              <description>しねきゃぷしょんプリセットで幅50%オプション使用選択時のバグを修正します。</description>
              <files>
                <file source="data/bugfixes/fontconfigs/lorefriendly_w50.txt" destination="Interface/fontconfig.txt" priority="0" />
                <file source="data/bugfixes/fontconfigs/lorefriendly_w50.txt" destination="Interface/fontconfig_ja.txt" priority="0" />
              </files>
              <typeDescriptor>
                  <type name="Optional" />
              </typeDescriptor>
            </plugin>
            
            <plugin name="しねきゃぷしょん 幅70%">
              <description>しねきゃぷしょんプリセットで幅70%オプション使用選択時のバグを修正します。</description>
              <files>
                <file source="data/bugfixes/fontconfigs/lorefriendly_w70.txt" destination="Interface/fontconfig.txt" priority="0" />
                <file source="data/bugfixes/fontconfigs/lorefriendly_w70.txt" destination="Interface/fontconfig_ja.txt" priority="0" />
              </files>
              <typeDescriptor>
                  <type name="Optional" />
              </typeDescriptor>
            </plugin>

            <plugin name="モダン 幅50%">
              <description>モダンプリセットで幅50%オプション使用選択時のバグを修正します。</description>
              <files>
                <file source="data/bugfixes/fontconfigs/modern_w50.txt" destination="Interface/fontconfig.txt" priority="0" />
                <file source="data/bugfixes/fontconfigs/modern_w50.txt" destination="Interface/fontconfig_ja.txt" priority="0" />
              </files>
              <typeDescriptor>
                  <type name="Optional" />
              </typeDescriptor>
            </plugin>

            <plugin name="モダン 幅70%">
              <description>モダンプリセットで幅70%オプション使用選択時のバグを修正します。</description>
              <files>
                <file source="data/bugfixes/fontconfigs/modern_w70.txt" destination="Interface/fontconfig.txt" priority="0" />
                <file source="data/bugfixes/fontconfigs/modern_w70.txt" destination="Interface/fontconfig_ja.txt" priority="0" />
              </files>
              <typeDescriptor>
                  <type name="Optional" />
              </typeDescriptor>
            </plugin>

            <plugin name="スカイリム互換 幅50%">
              <description>スカイリム互換プリセットで幅50%オプション使用選択時のバグを修正します。</description>
              <files>
                <file source="data/bugfixes/fontconfigs/skyrim_w50.txt" destination="Interface/fontconfig.txt" priority="0" />
                <file source="data/bugfixes/fontconfigs/skyrim_w50.txt" destination="Interface/fontconfig_ja.txt" priority="0" />
              </files>
              <typeDescriptor>
                  <type name="Optional" />
              </typeDescriptor>
            </plugin>

            <plugin name="スカイリム互換 幅70%">
              <description>スカイリム互換プリセットで幅70%オプション使用選択時のバグを修正します。</description>
              <files>
                <file source="data/bugfixes/fontconfigs/skyrim_w70.txt" destination="Interface/fontconfig.txt" priority="0" />
                <file source="data/bugfixes/fontconfigs/skyrim_w70.txt" destination="Interface/fontconfig_ja.txt" priority="0" />
              </files>
              <typeDescriptor>
                  <type name="Optional" />
              </typeDescriptor>
            </plugin>

            <plugin name="スムーズスカイリム 幅50%">
              <description>スカイリム互換プリセットで幅50%オプション使用選択時のバグを修正します。</description>
              <files>
                <file source="data/bugfixes/fontconfigs/smoothskyrim_w50.txt" destination="Interface/fontconfig.txt" priority="0" />
                <file source="data/bugfixes/fontconfigs/smoothskyrim_w50.txt" destination="Interface/fontconfig_ja.txt" priority="0" />
              </files>
              <typeDescriptor>
                  <type name="Optional" />
              </typeDescriptor>
            </plugin>

            <plugin name="スムーズスカイリム 幅70%">
              <description>スカイリム互換プリセットで幅70%オプション使用選択時のバグを修正します。</description>
              <files>
                <file source="data/bugfixes/fontconfigs/smoothskyrim_w70.txt" destination="Interface/fontconfig.txt" priority="0" />
                <file source="data/bugfixes/fontconfigs/smoothskyrim_w70.txt" destination="Interface/fontconfig_ja.txt" priority="0" />
              </files>
              <typeDescriptor>
                  <type name="Optional" />
              </typeDescriptor>
            </plugin>

          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>

    <!-- SkyUI -->
    <installStep name="SkyUI">
      <optionalFileGroups order="Explicit">
        <group name="SkyUI用MCM専用フォントマップ" type="SelectAtMostOne">
          <plugins>

            <plugin name="SkyUI v5.1用">
              <description>SkyUIのMCM画面が使用するフォントマップを変更するパッチです。
対象MOD: https://www.nexusmods.com/skyrim/mods/3863 v5.1
例えば幅が狭いフォントをMCM画面だけに適用したい時など、通常のフォントと分けたい場合に使用してください。

注意：MCMが使用するフォントマップを変更しますので、必ずfontconfig.txtに以下のフォントマップが適切に設定されていることを確認して下さい。
map "$MCMFont" = "フォント名" Normal
map "$MCMMediumFont" = "フォント名" Normal
map "$MCMBoldFont" = "フォント名" Normal</description>
              <files>
                <folder source="data/patches/skyui-mcmsf/skyui5.1" destination="" priority="0" />
              </files>
              <typeDescriptor>
                  <dependencyType>
                    <defaultType name="Optional" />
                    <patterns>
                      <pattern>
                        <dependencies operator="And">
                          <fileDependency file="SkyUI.esp" state="Active" />
                        </dependencies>
                        <type name="Recommended" />
                      </pattern>
                    </patterns>
                  </dependencyType>
              </typeDescriptor>
            </plugin>
            
            <plugin name="SkyUI-SE v5.2用">
              <description>SkyUIのMCM画面が使用するフォントマップを変更するパッチです。
対象MOD: https://www.nexusmods.com/skyrimspecialedition/mods/12604 v5.2
例えば幅が狭いフォントをMCM画面だけに適用したい時など、通常のフォントと分けたい場合に使用してください。

注意：MCMが使用するフォントマップを変更しますので、必ずfontconfig.txtに以下のフォントマップが適切に設定されていることを確認して下さい。
map "$MCMFont" = "フォント名" Normal
map "$MCMMediumFont" = "フォント名" Normal
map "$MCMBoldFont" = "フォント名" Normal</description>
              <files>
                <folder source="data/patches/skyui-mcmsf/skyui5.2se" destination="" priority="0" />
              </files>
              <typeDescriptor>
                  <dependencyType>
                    <defaultType name="Optional" />
                    <patterns>
                      <pattern>
                        <dependencies operator="And">
                          <fileDependency file="SkyUI_SE.esp" state="Active" />
                        </dependencies>
                        <type name="Recommended" />
                      </pattern>
                    </patterns>
                  </dependencyType>
              </typeDescriptor>
            </plugin>

            <plugin name="SkyUI-SE v6.7用">
              <description>SkyUIのMCM画面が使用するフォントマップを変更するパッチです。
対象MOD: https://www.nexusmods.com/skyrimspecialedition/mods/12604 v6.7
例えば幅が狭いフォントをMCM画面だけに適用したい時など、通常のフォントと分けたい場合に使用してください。

注意：MCMが使用するフォントマップを変更しますので、必ずfontconfig.txtに以下のフォントマップが適切に設定されていることを確認して下さい。
map "$MCMFont" = "フォント名" Normal
map "$MCMMediumFont" = "フォント名" Normal
map "$MCMBoldFont" = "フォント名" Normal</description>
              <files>
                <folder source="data/patches/skyui-mcmsf/skyui6.7se" destination="" priority="0" />
              </files>
              <typeDescriptor>
                  <dependencyType>
                    <defaultType name="Optional" />
                    <patterns>
                      <pattern>
                        <dependencies operator="And">
                          <fileDependency file="SkyUI_SE.esp" state="Active" />
                        </dependencies>
                        <type name="Recommended" />
                      </pattern>
                    </patterns>
                  </dependencyType>
              </typeDescriptor>
            </plugin>

            <plugin name="SkyUI-SE v6.8用">
              <description>SkyUIのMCM画面が使用するフォントマップを変更するパッチです。
対象MOD: https://www.nexusmods.com/skyrimspecialedition/mods/12604 v6.8
例えば幅が狭いフォントをMCM画面だけに適用したい時など、通常のフォントと分けたい場合に使用してください。

注意：MCMが使用するフォントマップを変更しますので、必ずfontconfig.txtに以下のフォントマップが適切に設定されていることを確認して下さい。
map "$MCMFont" = "フォント名" Normal
map "$MCMMediumFont" = "フォント名" Normal
map "$MCMBoldFont" = "フォント名" Normal</description>
              <files>
                <folder source="data/patches/skyui-mcmsf/skyui6.8se" destination="" priority="0" />
              </files>
              <typeDescriptor>
                  <dependencyType>
                    <defaultType name="Optional" />
                    <patterns>
                      <pattern>
                        <dependencies operator="And">
                          <fileDependency file="SkyUI_SE.esp" state="Active" />
                        </dependencies>
                        <type name="Recommended" />
                      </pattern>
                    </patterns>
                  </dependencyType>
              </typeDescriptor>
            </plugin>

          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>

  </installSteps>
</config>